{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "User's first name"
    },
    "last_name": {
      "type": "string",
      "description": "User's last name"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "driver"
      ],
      "default": "user"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "address",
    "birthday"
  ]
}