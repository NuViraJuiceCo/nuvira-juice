<?xml version="1.0" encoding="utf-8"?>
<!-- The approved square icon already includes a full background. Adaptive
     launchers expand the foreground by 1.5x; cancel that expansion with 1/6
     insets so the existing wordmark stays inside circular/squircle masks. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="16.67%" android:insetRight="16.67%"
    android:insetTop="16.67%" android:insetBottom="16.67%">
    <bitmap android:src="@mipmap/ic_launcher_foreground" android:gravity="fill" />
</inset>
