<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ masks splash artwork to a 192dp circle in a 288dp canvas.
     This exact, unmodified website wordmark fits inside that safe area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:width="176dp" android:height="69dp" android:gravity="center">
        <bitmap android:src="@drawable/nuvira_wordmark" android:gravity="fill" />
    </item>
</layer-list>
