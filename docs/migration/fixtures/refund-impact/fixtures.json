      "request": { "order_number": "SYN-ALREADY-REFUNDED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_already_refunded" },
      "state": { "customer_order": { "payment_status": "refunded", "financial_status": "refunded", "do_not_recover": true }, "native_order": { "payment_status": "refunded", "financial_status": "refunded", "production_status": "canceled" }, "fulfillment_task": false, "production_batches": [], "compliance_logs": [] },
