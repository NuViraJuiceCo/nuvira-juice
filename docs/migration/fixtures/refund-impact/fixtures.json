      "state": { "customer_order": true, "native_order": { "order_type": "one_time", "fulfillment_mode": "multi_delivery" }, "fulfillment_task": { "order_type": "one_time", "fulfillment_type": "delivery" }, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
