        "customer_order_cancelled_value_supported": false,
        "customer_proposed_status": null,
        "customer_proposed_status_supported": false,
        "next_action": "native_refund_preview_ready_full_refund_pre_production"
      }
    },
    {
      "name": "verified_batches_with_locked_compliance_logs",
      "description": "Multiple verified batches and locked logs must be linked and preserved.",
