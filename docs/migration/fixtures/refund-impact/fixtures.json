{
  "schema_version": "g35k_refund_impact_fixture_matrix_v2",
  "fixture_policy": {
    "synthetic_only": true,
    "no_real_customer_pii": true,
    "no_real_stripe_payloads": true,
    "no_raw_provider_payloads": true,
    "no_secrets_or_auth_values": true,
    "no_live_record_ids": true,
    "hub_remains_refund_source_of_truth": true,
    "native_refund_writes_approved": false
  },
  "defaults": {
    "request": {
      "preview_mode": "NATIVE_REFUND_IMPACT",
      "event_source": "test_fixture",
      "currency": "usd"
    },
    "customer_order": {
      "status": "scheduled_for_juicing",
      "payment_status": "paid",
      "financial_status": "paid",
      "payment_captured": true,
      "fulfillment_type": "delivery",
      "items": [
        { "name": "Synthetic Juice Bundle", "quantity": 1 }
      ]
    },
    "native_order": {
      "order_type": "one_time",
      "fulfillment_mode": "single_delivery",
      "fulfillment_method": "delivery",
      "source_type": "customer_app_native_mirror",
      "production_status": "new",
      "fulfillment_status": "pending",
      "payment_status": "paid",
      "financial_status": "paid",
      "line_items": [
        { "title": "Synthetic Juice Bundle", "quantity": 1 }
      ]
    },
    "fulfillment_task": {
      "order_type": "one_time",
      "fulfillment_type": "delivery",
      "status": "scheduled",
      "delivery_status": "pending"
    },
    "production_batch": {
      "status": "planned",
      "planned_units": 6,
      "product_name": "Synthetic Juice",
      "production_date": "2026-06-15"
    },
    "compliance_log": {
      "locked": true,
      "status": "verified_logged",
      "date": "2026-06-15",
      "juice_flavor": "Synthetic Juice"
    }
  },
  "fixtures": [
    {
      "name": "full_refund_before_native_ops",
      "description": "Paid one-time Customer App order exists before native order/task/batch operations.",
      "request": { "order_number": "SYN-FULL-BEFORE-OPS", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_before_ops" },
      "state": { "customer_order": true, "native_order": false, "fulfillment_task": false, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
        "order_found": true,
        "lifecycle_state": "before_native_ops",
        "lifecycle_risk_level": "low_risk_preview_only",
        "next_action": "native_refund_preview_ready_full_refund_pre_production",
        "production_batch_count": 0,
        "batch_compliance_log_count": 0,
        "native_order_present": false,
        "task_present": false
      }
    },
    {
      "name": "full_refund_after_native_order_created",
      "description": "Native ShopifyOrder mirror exists but no task or production batch exists.",
      "request": { "order_number": "SYN-FULL-NATIVE-ORDER", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_native_order" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": false, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
        "order_found": true,
        "lifecycle_state": "native_order_created_only",
        "lifecycle_risk_level": "low_risk_preview_only",
        "next_action": "native_refund_preview_ready_full_refund_pre_production",
        "native_order_present": true,
        "task_present": false,
        "native_order_proposed_payment_status": "refunded",
        "native_order_proposed_production_status": "canceled"
      }
    },
    {
      "name": "full_refund_after_task_created",
      "description": "FulfillmentTask exists before production batches are materialized.",
      "request": { "order_number": "SYN-FULL-TASK", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_task" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
        "order_found": true,
        "lifecycle_state": "task_scheduled_or_packed",
        "lifecycle_risk_level": "review_required",
        "next_action": "full_refund_preview_ready_task_cancellation_impact",
        "task_proposed_action": "preview_task_cancellation_impact",
        "would_cancel_task": false
      }
    },
    {
      "name": "full_refund_after_production_batches_planned",
      "description": "Planned ProductionBatch rows exist but production has not started.",
      "request": { "order_number": "SYN-FULL-BATCH-PLANNED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_batch_planned" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [{ "status": "planned" }, { "status": "planned", "product_name": "Synthetic Shot" }], "compliance_logs": [] },
      "expected": {
        "success": true,
        "lifecycle_state": "production_batches_planned",
        "lifecycle_risk_level": "review_required",
        "next_action": "full_refund_preview_ready_batch_recalculation_impact",
        "production_batch_count": 2,
        "batch_compliance_log_count": 0,
        "batch_action": "preview_order_source_removal_and_planned_units_recalculation",
        "would_remove_order_sources_now": false,
        "would_recalculate_planned_units_now": false
      }
    },
    {
      "name": "full_refund_after_production_started",
      "description": "ProductionBatch rows are in progress; refund impact is manual-review only.",
      "request": { "order_number": "SYN-FULL-PROD-STARTED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_prod_started" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [{ "status": "in_progress" }], "compliance_logs": [] },
      "expected": {
        "success": true,
        "lifecycle_state": "production_started",
        "lifecycle_risk_level": "high_risk_manual_only",
        "next_action": "production_started_manual_review_required",
        "blockers_include": ["production_started_manual_review_required"],
        "batch_action": "hold_batch_mutation_manual_review_only",
        "production_batch_mutation_proposed": false
      }
    },
    {
      "name": "full_refund_after_production_completed_pending_verification",
      "description": "Production completed but verification/compliance is not finalized.",
      "request": { "order_number": "SYN-FULL-PROD-COMPLETE", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_prod_complete" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [{ "status": "completed_pending_verification" }], "compliance_logs": [] },
      "expected": {
        "success": true,
        "lifecycle_state": "production_completed",
        "lifecycle_risk_level": "high_risk_manual_only",
        "next_action": "production_completed_manual_review_required",
        "blockers_include": ["production_completed_manual_review_required"],
        "batch_action": "hold_batch_mutation_manual_review_only"
      }
    },
    {
      "name": "full_refund_after_verified_logged",
      "description": "Verified ProductionBatch and locked BatchComplianceLog history exists.",
      "request": { "order_number": "SYN-FULL-VERIFIED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_verified" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [{ "status": "verified_logged", "compliance_log_id": "auto" }], "compliance_logs": [{ "locked": true }] },
      "expected": {
        "success": true,
        "lifecycle_state": "production_verified",
        "lifecycle_risk_level": "high_risk_manual_only",
        "next_action": "production_verified_manual_review_required",
        "blockers_include": ["production_verified_manual_review_required"],
        "production_batch_count": 1,
        "verified_logged_batch_count": 1,
        "batch_compliance_log_count": 1,
        "locked_compliance_log_count": 1,
        "warnings_include": ["verified_production_history_preserved", "locked_compliance_logs_preserved"]
      }
    },
    {
      "name": "full_refund_after_task_packed_order_bottled",
      "description": "Task is packed and native order is bottled; refund requires review.",
      "request": { "order_number": "SYN-FULL-PACKED-BOTTLED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_packed_bottled" },
      "state": { "customer_order": true, "native_order": { "production_status": "bottled", "fulfillment_status": "pending" }, "fulfillment_task": { "status": "packed", "delivery_status": "pending" }, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
        "lifecycle_state": "task_packed",
        "lifecycle_risk_level": "review_required",
        "next_action": "full_refund_review_required_task_packed",
        "task_proposed_action": "preview_task_cancellation_impact",
        "would_cancel_task": false
      }
    },
    {
      "name": "full_refund_after_delivered",
      "description": "Delivered order with fulfilled native ShopifyOrder, verified batches, and locked compliance logs.",
      "request": { "order_number": "SYN-FULL-DELIVERED", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_full_delivered" },
      "state": { "customer_order": { "status": "delivered" }, "native_order": { "production_status": "bottled", "fulfillment_status": "fulfilled" }, "fulfillment_task": { "status": "delivered", "delivery_status": "delivered" }, "production_batches": [{ "status": "verified_logged", "compliance_log_id": "auto" }], "compliance_logs": [{ "locked": true }] },
      "expected": {
        "success": true,
        "lifecycle_state": "delivered",
        "lifecycle_risk_level": "do_not_auto_cancel",
        "next_action": "delivered_refund_manual_review_required",
        "blockers_include": ["delivered_manual_review_required"],
        "warnings_include": ["delivered_refund_manual_review_required", "verified_production_history_preserved", "locked_compliance_logs_preserved"],
        "task_proposed_action": "do_not_auto_cancel_delivered_or_completed_task",
        "production_batch_count": 1,
        "verified_logged_batch_count": 1,
        "batch_compliance_log_count": 1,
        "locked_compliance_log_count": 1
      }
    },
    {
      "name": "partial_refund_any_stage",
      "description": "Partial refund should route to review only and not cancel task/order/batches.",
      "request": { "order_number": "SYN-PARTIAL", "refund_type": "partial", "refund_amount": 10.00, "stripe_event_id": "evt_test_partial" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": true, "production_batches": [{ "status": "planned" }], "compliance_logs": [] },
      "expected": {
        "success": true,
        "lifecycle_state": "production_batches_planned",
        "lifecycle_risk_level": "review_required",
        "next_action": "partial_refund_review_required",
        "warnings_include": ["partial_refund_review_only_no_automatic_mutation"],
        "review_queue_incident_type": "partial_refund_received",
        "would_cancel_task": false,
        "native_order_action": "hold_native_order_mutation_review_only"
      }
    },
    {
      "name": "duplicate_refund_event",
      "description": "Duplicate Stripe event id has already been recorded in synthetic audit context.",
      "request": { "order_number": "SYN-DUPLICATE", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_duplicate" },
      "state": { "customer_order": true, "native_order": true, "fulfillment_task": false, "production_batches": [], "compliance_logs": [], "order_sync_logs": [{ "id": "sync_duplicate", "stripe_event_id": "evt_test_duplicate", "status": "success", "action": "refund_processed" }] },
      "expected": {
        "success": true,
        "next_action": "duplicate_refund_event_detected",
        "duplicate_event_detected": true,
        "future_command_should": "skip_idempotent",
        "order_sync_log_match_count": 1
      }
    },
    {
      "name": "unknown_order_refund",
      "description": "Refund event cannot be matched to Customer App, native order, or task records.",
      "request": { "order_number": "SYN-UNKNOWN", "refund_type": "full", "refund_amount": 42.00, "stripe_event_id": "evt_test_unknown" },
      "state": { "customer_order": false, "native_order": false, "fulfillment_task": false, "production_batches": [], "compliance_logs": [] },
      "expected": {
        "success": true,
        "order_found": false,
        "next_action": "unknown_order_review_required",
        "warnings_include": ["unknown_order_review_required"],
        "review_queue_incident_type": "refund_received_unknown_order"
      }
    },
    {
      "name": "missing_stripe_event_id",
      "description": "No Stripe event id is supplied; preview remains dry-run but future command would require stronger idempotency.",
