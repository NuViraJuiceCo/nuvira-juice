{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer's full name"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "is_program": {
            "type": "boolean"
          },
          "program_key": {
            "type": "string",
            "enum": ["radiance", "hydration", "reset"]
          },
          "program_days": {
            "type": "number",
            "enum": [2, 3]
          },
          "program_schedule_version": {
            "type": "string"
          },
          "bottles_per_unit": {
            "type": "number"
          },
          "bundle_composition": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_id": { "type": "string" },
                "product_name": { "type": "string" },
                "quantity": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "default": "delivery"
    },
    "customer_app_subscription_id": {
      "type": "string",
      "description": "Internal parent Subscription.id link for future subscription occurrence orders. Nullable for one-time and historical rows."
    },
    "subscription_occurrence_id": {
      "type": "string",
      "description": "Internal immutable occurrence id for future subscription occurrence orders. Nullable for existing rows and not customer-facing."
    },
    "subscription_cycle_key": {
      "type": "string",
      "description": "Internal secondary cycle key for future subscription occurrence orders. Not sufficient as the sole occurrence identity."
    },
    "fulfillment_number": {
      "type": "number",
      "description": "Internal subscription occurrence fulfillment sequence/reference. Nullable for one-time and historical rows."
    },
    "source_type": {
      "type": "string",
      "description": "Internal source classification such as one_time or subscription_occurrence. Not customer-facing in OCC4."
    },
    "delivery_address": {
      "type": "string",
      "description": "Full address string (legacy / display)"
    },
    "address_line1": {
      "type": "string",
      "description": "Street address line 1"
    },
    "address_line2": {
      "type": "string",
      "description": "Apt, suite, unit, etc."
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_postal_code": {
      "type": "string"
    },
    "address_country": {
      "type": "string",
      "default": "US"
    },
    "contact_phone": {
      "type": "string"
    },
    "estimated_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Scheduled delivery date after production is verified"
    },
    "assigned_delivery_window_start": {
      "type": "string",
      "description": "Delivery window start time, e.g. 17:00 for 5:00 PM"
    },
    "assigned_delivery_window_end": {
      "type": "string",
      "description": "Delivery window end time, e.g. 20:00 for 8:00 PM"
    },
    "delivery_window_label": {
      "type": "string",
      "description": "Customer-facing window label, e.g. '5:00 PM - 8:00 PM'"
    },
    "delivery_window_timezone": {
      "type": "string",
      "default": "America/Chicago",
      "description": "Timezone for delivery window"
    },
    "status": {
      "type": "string",
      "enum": [
        "order_received",
        "scheduled_for_juicing",
        "in_production",
        "bottled_packed",
        "out_for_delivery",
        "arriving_soon",
        "delivered",
        "ready_for_pickup",
        "picked_up"
      ],
      "default": "order_received"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Referral code used on this order"
    },
    "promotion_code": {
      "type": "string",
      "description": "Public promotion code applied to this order"
    },
    "promotion_discount_percent": {
      "type": "number",
      "default": 0,
      "description": "Server-authorized percentage discount applied to merchandise"
    },
    "promotion_discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Server-calculated promotion discount amount in USD"
    },
    "total_discounts": {
      "type": "number",
      "default": 0,
      "description": "Total of all checkout discounts applied to this order in USD"
    },
    "discount_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Normalized discount and referral codes applied to this order"
    },
    "delivery_photo_url": {
      "type": "string",
      "description": "Proof of delivery photo taken by driver"
    },
    "delivery_drop_location": {
      "type": "string",
      "description": "Where the driver left the order (e.g. Front door, With neighbor)"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Delivery completion notes captured by driver or admin"
    },
    "delivered_by": {
      "type": "string",
      "description": "Driver email who completed the delivery"
    },
    "delivered_at": {
      "type": "string",
      "description": "ISO timestamp of actual delivery"
    },
    "is_preorder": {
      "type": "boolean",
      "default": false
    },
    "preorder_fulfillment_date": {
      "type": "string",
      "format": "date"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "payment_captured": {
      "type": "boolean",
      "default": false
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Deprecated transition alias for assigned_production_day (YYYY-MM-DD)"
    },
    "assigned_production_day": {
      "type": "string",
      "format": "date",
      "description": "Canonical production date assigned by the schedule engine (YYYY-MM-DD)"
    },
    "assigned_delivery_day": {
      "type": "string",
      "description": "Wednesday, Saturday, or Sunday (from production window)"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "pending",
        "scheduled_for_production",
        "in_production",
        "completed",
        "cancelled"
      ]
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "pending_production",
        "ready_for_delivery",
        "in_transit",
        "delivered",
        "cancelled"
      ]
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "not_ready",
        "ready",
        "in_transit",
        "delivered"
      ]
    },
    "ready_for_driver": {
      "type": "boolean",
      "default": false,
      "description": "Only true when batch verified AND fulfillment_status = ready_for_delivery"
    },
    "batch_trigger": {
      "type": "string",
      "description": "What triggered batch assignment (e.g. window_1_default, saturday_threshold_met)"
    },
    "scheduling_reason": {
      "type": "string",
      "description": "Why order was assigned to this production window"
    },
    "final_schedule_source": {
      "type": "string",
      "description": "Source of schedule calculation (e.g. 'central_engine'). Phase 5 contract field."
    },
    "schedule_timezone": {
      "type": "string",
      "default": "America/Chicago",
      "description": "Timezone for schedule calculation. Phase 5 contract field."
    },
    "cutoff_window_label": {
      "type": "string",
      "description": "Cutoff window label from schedule engine (e.g. 'Friday after 2:00 PM'). Phase 5 contract field."
    },
    "financial_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "failed"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "refunded",
        "failed"
      ]
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "pending_review",
        "partially_refunded",
        "fully_refunded",
        "review_required",
        "ignored_duplicate"
      ],
      "description": "Optional refund/payment reversal state. Does not replace lifecycle Order.status."
    },
    "refund_type": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "unknown"
      ],
      "description": "Optional refund type for native refund review/audit flows."
    },
    "refund_amount": {
      "type": "number",
      "description": "Optional refund amount captured for review/audit. No native refund write behavior is implied."
    },
    "refund_currency": {
      "type": "string",
      "description": "Optional ISO currency code for refund_amount."
    },
    "refunded_at": {
      "type": "string",
      "description": "Optional ISO timestamp when a refund was confirmed by the current source of truth."
    },
    "refund_source": {
      "type": "string",
      "enum": [
        "stripe_webhook",
        "admin",
        "hub_mirror",
        "manual_review"
      ],
      "description": "Optional source label for refund state."
    },
    "refund_event_id": {
      "type": "string",
      "description": "Optional provider or internal refund event id used for idempotency/audit."
    },
    "stripe_refund_id": {
      "type": "string",
      "description": "Optional Stripe refund id when safely available from an approved refund source."
    },
    "refund_reason": {
      "type": "string",
      "description": "Optional safe refund reason or admin summary. Do not store raw provider payloads."
    },
    "refund_review_required": {
      "type": "boolean",
      "description": "Optional marker that refund handling requires manual review before any native write."
    },
    "refund_review_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "reviewed",
        "resolved",
        "rejected"
      ],
      "description": "Optional manual review lifecycle for refund/payment reversal handling."
    },
    "do_not_recover": {
      "type": "boolean",
      "default": false,
      "description": "Flag to prevent order re-entry into production if refunded/cancelled"
    },
    "canceled_at": {
      "type": "string",
      "description": "ISO timestamp when order was cancelled"
    },
    "deleted_at": {
      "type": "string",
      "description": "ISO timestamp when order was deleted"
    },
    "is_test_order": {
      "type": "boolean",
      "default": false,
      "description": "Test orders excluded from production scheduling"
    },
    "saturday_threshold_decision": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected_rolled_to_tuesday"
      ],
      "description": "Window 3 threshold decision status"
    },
    "saturday_threshold_decided_at": {
      "type": "string",
      "description": "ISO timestamp when Saturday threshold was evaluated"
    },
    "health_advisory_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Customer acknowledged health advisory before order placement"
    },
    "health_advisory_acknowledged_at": {
      "type": "string",
      "description": "ISO timestamp when customer acknowledged health advisory"
    },
    "health_advisory_version": {
      "type": "string",
      "description": "Version of health advisory acknowledged (e.g. 2026-05-13-v1)"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
