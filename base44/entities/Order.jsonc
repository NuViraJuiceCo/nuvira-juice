{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "default": "delivery"
    },
    "delivery_address": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "estimated_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "order_received",
        "scheduled_for_juicing",
        "in_production",
        "bottled_packed",
        "out_for_delivery",
        "arriving_soon",
        "delivered",
        "ready_for_pickup",
        "picked_up"
      ],
      "default": "order_received"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "is_preorder": {
      "type": "boolean",
      "default": false,
      "description": "True if this order was placed during a pre-order window"
    },
    "preorder_fulfillment_date": {
      "type": "string",
      "format": "date",
      "description": "The date when this pre-order will be fulfilled / payment captured"
    },
    "stripe_payment_intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent ID for manual capture pre-orders"
    },
    "stripe_checkout_session_id": {
      "type": "string",
      "description": "Stripe Checkout Session ID"
    },
    "payment_captured": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Stripe payment has been captured (always true for regular orders)"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}