{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup"
      ],
      "default": "delivery"
    },
    "delivery_address": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "estimated_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "order_received",
        "scheduled_for_juicing",
        "in_production",
        "bottled_packed",
        "out_for_delivery",
        "arriving_soon",
        "delivered",
        "ready_for_pickup",
        "picked_up"
      ],
      "default": "order_received"
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Referral code used on this order"
    },
    "delivery_photo_url": {
      "type": "string",
      "description": "Proof of delivery photo taken by driver"
    },
    "delivery_drop_location": {
      "type": "string",
      "description": "Where the driver left the order (e.g. Front door, With neighbor)"
    },
    "delivered_by": {
      "type": "string",
      "description": "Driver email who completed the delivery"
    },
    "delivered_at": {
      "type": "string",
      "description": "ISO timestamp of actual delivery"
    },
    "is_preorder": {
      "type": "boolean",
      "default": false
    },
    "preorder_fulfillment_date": {
      "type": "string",
      "format": "date"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "payment_captured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_email",
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}