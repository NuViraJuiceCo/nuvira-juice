{
  "name": "CustomerMessageDeliveryLog",
  "type": "object",
  "properties": {
    "idempotency_key": {
      "type": "string",
      "description": "Unique key used to prevent duplicate customer message delivery"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "sms",
        "push",
        "in_app"
      ]
    },
    "message_type": {
      "type": "string",
      "enum": [
        "order_confirmation",
        "order_status",
        "transactional_order",
        "subscription_upcoming_delivery",
        "refund",
        "zone3_approval",
        "zone3_denial"
      ]
    },
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "resend",
        "sendblue",
        "internal"
      ]
    },
    "provider_message_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "scheduled",
        "sent",
        "delivered",
        "delivery_delayed",
        "bounced",
        "failed",
        "suppressed",
        "complained",
        "skipped"
      ],
      "default": "sent"
    },
    "error_message": {
      "type": "string",
      "maxLength": 1000
    },
    "sent_at": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    },
    "delivery_delayed_at": {
      "type": "string"
    },
    "bounced_at": {
      "type": "string"
    },
    "failed_at": {
      "type": "string"
    },
    "suppressed_at": {
      "type": "string"
    },
    "complained_at": {
      "type": "string"
    },
    "opened_at": {
      "type": "string"
    },
    "clicked_at": {
      "type": "string"
    },
    "last_provider_event": {
      "type": "string"
    },
    "last_provider_event_at": {
      "type": "string"
    },
    "last_webhook_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "idempotency_key",
    "channel",
    "message_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
