{
  "name": "DailyChecklist",
  "type": "object",
  "properties": {
    "checklist_date": {
      "type": "string",
      "format": "date",
      "description": "Date of checklist"
    },
    "staff_member": {
      "type": "string",
      "description": "Staff member responsible for checklist"
    },
    "batch_id": {
      "type": "string",
      "description": "Current production batch display ID tied to this checklist update, if applicable"
    },
    "source_production_batch_id": {
      "type": "string",
      "description": "Source ProductionBatch entity ID tied to this checklist update, if applicable"
    },
    "related_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related production batch IDs covered by this daily checklist"
    },
    "related_source_production_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related source ProductionBatch entity IDs covered by this daily checklist"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Morning",
        "Afternoon",
        "Night"
      ],
      "description": "Shift"
    },
    "morning_fridge_temp_logged": {
      "type": "boolean",
      "description": "Morning refrigerator temperature logged?"
    },
    "morning_fridge_time": {
      "type": "string",
      "description": "Time of morning log (HH:MM)"
    },
    "evening_fridge_temp_logged": {
      "type": "boolean",
      "description": "Evening refrigerator temperature logged?"
    },
    "evening_fridge_time": {
      "type": "string",
      "description": "Time of evening log (HH:MM)"
    },
    "sanitizer_levels_checked": {
      "type": "boolean",
      "description": "Sanitizer levels checked?"
    },
    "sanitizer_check_time": {
      "type": "string",
      "description": "Time of check (HH:MM)"
    },
    "equipment_sanitized": {
      "type": "boolean",
      "description": "Equipment sanitized?"
    },
    "sanitization_time": {
      "type": "string",
      "description": "Time sanitization completed (HH:MM)"
    },
    "work_areas_cleaned": {
      "type": "boolean",
      "description": "Work areas cleaned?"
    },
    "cleaning_time": {
      "type": "string",
      "description": "Time cleaning completed (HH:MM)"
    },
    "batch_logs_completed": {
      "type": "boolean",
      "description": "All production batch logs completed?"
    },
    "batches_logged": {
      "type": "string",
      "description": "Which batches were logged (e.g., #101, #102)"
    },
    "ccp_logs_completed": {
      "type": "boolean",
      "description": "All CCP logs completed?"
    },
    "ccp_notes": {
      "type": "string",
      "description": "CCP details or notes"
    },
    "issues_reported": {
      "type": "string",
      "description": "Any issues or concerns reported"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "Complete",
        "Incomplete",
        "Pending",
        "Pre-Production Complete"
      ],
      "description": "Checklist completion status"
    },
    "completed_at": {
      "type": "string",
      "description": "When checklist was marked complete (timestamp)"
    },
    "manager_reviewed": {
      "type": "boolean",
      "description": "Has manager reviewed this checklist?"
    },
    "manager_comments": {
      "type": "string",
      "description": "Manager review comments"
    },
    "is_test_record": {
      "type": "boolean",
      "default": false,
      "description": "Derived from the linked ProductionBatch; excluded from normal compliance totals when true"
    },
    "test_batch_id": {
      "type": "string",
      "description": "Display ID of the linked internal test ProductionBatch"
    }
  },
  "required": [
    "checklist_date",
    "staff_member",
    "shift"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
