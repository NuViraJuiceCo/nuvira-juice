{
  "name": "SanitationLog",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date",
      "description": "Date of log entry"
    },
    "log_time": {
      "type": "string",
      "description": "Time of log entry (HH:MM format)"
    },
    "staff_member": {
      "type": "string",
      "description": "Name of staff member who logged"
    },
    "batch_id": {
      "type": "string",
      "description": "Production batch display ID tied to this sanitation check, if applicable"
    },
    "source_production_batch_id": {
      "type": "string",
      "description": "Source ProductionBatch entity ID tied to this sanitation check, if applicable"
    },
    "related_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related production batch IDs covered by this sanitation check"
    },
    "related_source_production_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related source ProductionBatch entity IDs covered by this sanitation check"
    },
    "area": {
      "type": "string",
      "enum": [
        "Prep Area",
        "Production Floor",
        "Packing Area",
        "Cold Storage",
        "Equipment",
        "Bathrooms"
      ],
      "description": "Area being sanitized/checked"
    },
    "sanitizer_type": {
      "type": "string",
      "description": "Type of sanitizer used"
    },
    "sanitizer_level": {
      "type": "string",
      "enum": [
        "Low",
        "Adequate",
        "Optimal"
      ],
      "description": "Sanitizer level status"
    },
    "cleaned": {
      "type": "boolean",
      "description": "Was area cleaned?"
    },
    "sanitized": {
      "type": "boolean",
      "description": "Was area sanitized?"
    },
    "verified_by": {
      "type": "string",
      "description": "Person who verified sanitation (if different)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or issues found"
    },
    "is_test_record": {
      "type": "boolean",
      "default": false,
      "description": "Derived from the linked ProductionBatch; excluded from normal compliance totals when true"
    },
    "test_batch_id": {
      "type": "string",
      "description": "Display ID of the linked internal test ProductionBatch"
    }
  },
  "required": [
    "log_date",
    "log_time",
    "staff_member",
    "area",
    "sanitizer_type",
    "cleaned",
    "sanitized"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
