{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Authenticated customer email that owns this push subscription"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "web_push",
        "fcm"
      ],
      "default": "web_push",
      "description": "Transport used by this subscription"
    },
    "endpoint": {
      "type": "string",
      "description": "Browser Push API endpoint URL"
    },
    "p256dh": {
      "type": "string",
      "description": "Push subscription p256dh key"
    },
    "auth": {
      "type": "string",
      "description": "Push subscription auth secret"
    },
    "fcm_token": {
      "type": "string",
      "description": "Firebase Cloud Messaging registration token for native iOS/Android shells"
    },
    "device_platform": {
      "type": "string",
      "description": "Native platform such as ios or android"
    },
    "app_shell": {
      "type": "string",
      "description": "App shell that registered the token"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "permission": {
      "type": "string",
      "enum": [
        "default",
        "granted",
        "denied"
      ],
      "default": "default"
    },
    "platform": {
      "type": "string",
      "description": "Browser/platform descriptor captured during registration"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent captured during registration"
    },
    "last_seen_at": {
      "type": "string",
      "description": "Last successful registration or push send timestamp"
    },
    "revoked_at": {
      "type": "string",
      "description": "Timestamp when this subscription was disabled locally or expired remotely"
    }
  },
  "required": [
    "customer_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
