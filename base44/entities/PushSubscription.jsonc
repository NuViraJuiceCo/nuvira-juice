{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Authenticated customer email that owns this push subscription"
    },
    "token_type": {
      "type": "string",
      "enum": [
        "web_push",
        "fcm",
        "apns"
      ],
      "default": "web_push",
      "description": "Transport used by this subscription"
    },
    "endpoint": {
      "type": "string",
      "description": "Browser Push API endpoint URL"
    },
    "p256dh": {
      "type": "string",
      "description": "Push subscription p256dh key"
    },
    "auth": {
      "type": "string",
      "description": "Push subscription auth secret"
    },
    "fcm_token": {
      "type": "string",
      "description": "Firebase Cloud Messaging registration token for native iOS/Android shells"
    },
    "apns_token": {
      "type": "string",
      "description": "Apple Push Notification service device token for native iOS shells"
    },
    "apns_environment": {
      "type": "string",
      "enum": [
        "unknown",
        "sandbox",
        "production"
      ],
      "default": "unknown",
      "description": "APNs environment when known"
    },
    "app_bundle_id": {
      "type": "string",
      "description": "Native app bundle identifier for APNs topic routing"
    },
    "device_platform": {
      "type": "string",
      "description": "Native platform such as ios or android"
    },
    "app_shell": {
      "type": "string",
      "description": "App shell that registered the token"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "permission": {
      "type": "string",
      "enum": [
        "default",
        "granted",
        "denied"
      ],
      "default": "default"
    },
    "platform": {
      "type": "string",
      "description": "Browser/platform descriptor captured during registration"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent captured during registration"
    },
    "last_seen_at": {
      "type": "string",
      "description": "Last successful registration or push send timestamp"
    },
    "revoked_at": {
      "type": "string",
      "description": "Timestamp when this subscription was disabled locally or expired remotely"
    }
  },
  "required": [
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
