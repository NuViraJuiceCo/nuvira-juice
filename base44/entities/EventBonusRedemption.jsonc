{
  "name": "EventBonusRedemption",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "auth_email": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "awarded",
        "skipped",
        "failed"
      ],
      "default": "awarded"
    },
    "claimed_at": {
      "type": "string"
    }
  },
  "required": [
    "event_key",
    "customer_email",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.auth_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
