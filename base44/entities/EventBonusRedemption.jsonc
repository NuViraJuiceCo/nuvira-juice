{
  "name": "EventBonusRedemption",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "auth_email": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "points_awarded": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "awarded",
        "skipped",
        "failed"
      ],
      "default": "awarded"
    },
    "event_session_id": {
      "type": "string",
      "description": "Safe event-session identifier used for the check-in"
    },
    "event_session_title": {
      "type": "string",
      "description": "Display title of the event session used for the check-in"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "event_code",
        "geofence"
      ],
      "description": "Safe verification method used to approve the event bonus"
    },
    "location_distance_meters": {
      "type": "number",
      "description": "Rounded distance from event location when location was provided; raw coordinates are not stored"
    },
    "claimed_at": {
      "type": "string"
    }
  },
  "required": [
    "event_key",
    "customer_email",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.auth_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
