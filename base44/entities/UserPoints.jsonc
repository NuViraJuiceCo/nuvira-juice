{
  "name": "UserPoints",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional admin note about this loyalty points account (up to 1000 characters)",
      "maxLength": 1000
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "lifetime_points": {
      "type": "number",
      "default": 0
    },
    "redeemed_points": {
      "type": "number",
      "default": 0
    },
    "points_ledger_revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Monotonic conditional-write revision for balances, receipts and reservations."
    },
    "reserved_points": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Points held for uncompleted payments; available points equal total minus reserved."
    },
    "reward_reservations": {
      "type": "array",
      "default": [],
      "description": "Server-managed payment holds. Declines and local timeouts do not release a retryable payment hold.",
      "items": {
        "type": "object",
        "properties": {
          "reservation_id": { "type": "string" },
          "context_hash": { "type": "string" },
          "points": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["held", "consumed", "released"] },
          "payment_intent_id": { "type": "string" },
          "created_at": { "type": "string" },
          "settled_at": { "type": "string" }
        }
      }
    },
    "points_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "earned",
              "redeemed",
              "bonus"
            ]
          },
          "description": {
            "type": "string"
          },
          "event_key": {
            "type": "string",
            "description": "Optional event key for one-time event bonus awards"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Optional idempotency key used to prevent duplicate point awards"
          },
          "transaction_id": { "type": "string" },
          "transaction_type": { "type": "string" },
          "balanceBefore": { "type": "integer" },
          "balanceAfter": { "type": "integer" },
          "lifetimeBefore": { "type": "integer" },
          "lifetimeAfter": { "type": "integer" },
          "redeemedBefore": { "type": "integer" },
          "redeemedAfter": { "type": "integer" },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "claimed_rewards": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "reward_id": {
            "type": "string"
          },
          "reward_title": {
            "type": "string"
          },
          "reward_type": {
            "type": "string"
          },
          "points_required": {
            "type": "integer",
            "minimum": 1,
            "description": "Canonical catalog cost at selection; selection itself does not debit points."
          },
          "status": {
            "type": "string",
            "description": "Selection lifecycle, including selected_pending_checkout; not proof of completed redemption."
          },
          "claimed_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
