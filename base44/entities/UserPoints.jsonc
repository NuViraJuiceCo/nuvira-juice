{
  "name": "UserPoints",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "lifetime_points": {
      "type": "number",
      "default": 0
    },
    "redeemed_points": {
      "type": "number",
      "default": 0
    },
    "points_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "earned",
              "redeemed",
              "bonus"
            ]
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_email"
  ]
}