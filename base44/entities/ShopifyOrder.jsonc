{
  "name": "ShopifyOrder",
  "type": "object",
  "properties": {
    "shopify_order_id": {
      "type": "string",
      "description": "Shopify order GID or numeric ID when the order originated from Shopify. Native Customer App operational orders may not have this at creation time."
    },
    "shopify_order_number": {
      "type": "string",
      "description": "e.g. #1001"
    },
    "description": {
      "type": "string",
      "description": "Optional admin note or summary for this Shopify order (up to 1000 characters)",
      "maxLength": 1000
    },
    "base44_order_id": {
      "type": "string",
      "description": "Linked Base44 Order record ID"
    },
    "source_channel": {
      "type": "string",
      "enum": [
        "online",
        "pos",
        "draft",
        "subscription",
        "wholesale",
        "admin",
        "event"
      ],
      "default": "online"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shopify_line_item_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "variant_title": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "total_discount": {
            "type": "number"
          }
        }
      }
    },
    "fulfillment_method": {
      "type": "string",
      "enum": [
        "delivery",
        "pickup",
        "shipping",
        "pos"
      ],
      "default": "delivery"
    },
    "delivery_address": {
      "type": "string"
    },
    "requested_delivery_date": {
      "type": "string"
    },
    "requested_time_window": {
      "type": "string"
    },
    "payment_status": {
      "type": "string"
    },
    "fulfillment_status": {
      "type": "string"
    },
    "shopify_fulfillment_status": {
      "type": "string"
    },
    "financial_status": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "total_tax": {
      "type": "number"
    },
    "total_discounts": {
      "type": "number"
    },
    "tip_received": {
      "type": "number"
    },
    "total_price": {
      "type": "number"
    },
    "discount_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "customer_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_pos_order": {
      "type": "boolean",
      "default": false
    },
    "is_subscription": {
      "type": "boolean",
      "default": false
    },
    "subscription_cadence": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        ""
      ]
    },
    "event_name": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_location": {
      "type": "string"
    },
    "assigned_driver": {
      "type": "string"
    },
    "production_status": {
      "type": "string",
      "enum": [
        "new",
        "awaiting_production",
        "in_production",
        "bottled",
        "labeled",
        "qc_checked",
        "packed",
        "in_cold_storage",
        "assigned_for_pickup",
        "assigned_for_delivery",
        "not_required",
        "fulfilled",
        "canceled",
        "refunded"
      ],
      "default": "new"
    },
    "workflow_checklist": {
      "type": "object",
      "properties": {
        "produce_pulled": {
          "type": "boolean",
          "default": false
        },
        "ingredients_prepped": {
          "type": "boolean",
          "default": false
        },
        "juice_pressed": {
          "type": "boolean",
          "default": false
        },
        "bottled": {
          "type": "boolean",
          "default": false
        },
        "labeled": {
          "type": "boolean",
          "default": false
        },
        "qc_checked": {
          "type": "boolean",
          "default": false
        },
        "packed": {
          "type": "boolean",
          "default": false
        },
        "in_cold_storage": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "shopify_synced_at": {
      "type": "string"
    },
    "shopify_raw_payload": {
      "type": "object"
    },
    "assigned_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "one_time",
        "subscription",
        "pos",
        "wholesale",
        "admin",
        "event"
      ],
      "description": "Operational order classification used by native safeSyncOrderUpdate parity."
    },
    "fulfillment_mode": {
      "type": "string",
      "enum": [
        "single_delivery",
        "multi_delivery"
      ],
      "description": "Whether the order has one fulfillment occurrence or multiple subscription/delivery occurrences."
    },
    "customer_order_date": {
      "type": "string"
    },
    "internal_customer_id": {
      "type": "string"
    },
    "customer_app_user_id": {
      "type": "string"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_state": {
      "type": "string"
    },
    "address_postal_code": {
      "type": "string"
    },
    "address_country": {
      "type": "string"
    },
    "delivery_notes": {
      "type": "string"
    },
    "address_last_synced_from": {
      "type": "string"
    },
    "address_last_synced_at": {
      "type": "string"
    },
    "fulfillments": {
      "type": "array",
      "description": "Operational fulfillment occurrence snapshots used by subscription and production safety guards.",
      "items": {
        "type": "object"
      }
    },
    "production_snapshot": {
      "type": "object",
      "description": "Line item and fulfillment snapshot captured before production-sensitive order fields are frozen."
    },
    "selected_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "production_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_window_label": {
      "type": "string"
    },
    "order_lock_status": {
      "type": "string",
      "enum": [
        "unlocked",
        "verified",
        "production_scheduled",
        "in_production",
        "out_for_delivery",
        "fulfilled"
      ],
      "description": "Operational lifecycle lock level for safeSyncOrderUpdate frozen-field enforcement."
    },
    "order_status": {
      "type": "string"
    },
    "operational_visibility": {
      "type": "string"
    },
    "sync_status": {
      "type": "string"
    },
    "last_sync_at": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_invoice_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_event_id_applied": {
      "type": "string"
    },
    "stripe_created_event_type": {
      "type": "string"
    },
    "last_reconciliation_at": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "repair_status": {
      "type": "string"
    },
    "repair_timestamp": {
      "type": "string"
    },
    "repair_method": {
      "type": "string"
    },
    "subscription_parent_id": {
      "type": "string"
    },
    "fulfillment_instance_date": {
      "type": "string",
      "format": "date"
    },
    "fulfillment_sequence_number": {
      "type": "number"
    },
    "source_invoice_id": {
      "type": "string"
    },
    "data_quality_status": {
      "type": "string"
    },
    "last_verified_at": {
      "type": "string"
    },
    "delivery_photo_url": {
      "type": "string"
    },
    "delivery_drop_location": {
      "type": "string"
    },
    "delivered_by": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    },
    "manual_override": {
      "type": "boolean"
    },
    "manual_override_at": {
      "type": "string"
    },
    "manual_override_by": {
      "type": "string"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "delivery_zone_key": {
      "type": "string"
    },
    "delivery_zone_name": {
      "type": "string"
    },
    "delivery_zone_type": {
      "type": "string"
    },
    "delivery_fee": {
      "type": "number"
    },
    "minimum_order": {
      "type": "number"
    },
    "distance_miles": {
      "type": "number"
    },
    "drive_time_minutes": {
      "type": "number"
    },
    "approval_request_id": {
      "type": "string"
    },
    "approval_status": {
      "type": "string"
    },
    "approved_delivery_fee": {
      "type": "number"
    },
    "route_review_required": {
      "type": "boolean"
    },
    "origin_address": {
      "type": "string"
    },
    "refunded_at": {
      "type": "string"
    },
    "cancel_type": {
      "type": "string"
    },
    "excluded_from_production": {
      "type": "boolean"
    }
  },
  "required": [
    "shopify_order_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
