{
  "name": "SubscriptionPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan name (e.g., Weekly Fresh, Monthly Ritual)"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "description": "Delivery frequency"
    },
    "base_price": {
      "type": "number",
      "description": "Price per cycle"
    },
    "bottle_count": {
      "type": "number",
      "description": "Total bottles per delivery"
    },
    "discount_percent": {
      "type": "number",
      "description": "Discount percentage off regular prices"
    },
    "perks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of benefits"
    },
    "composition_template": {
      "type": "object",
      "description": "How bottles are composed (flavors & quantities per delivery)",
      "properties": {
        "deliveries_per_cycle": {
          "type": "number",
          "description": "Number of deliveries in this billing cycle (1 for weekly, 4 for monthly)"
        },
        "bottles_per_delivery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "flavor": {
                "type": "string",
                "enum": [
                  "AURA",
                  "RE-NU",
                  "OASIS"
                ]
              },
              "quantity": {
                "type": "number"
              }
            }
          },
          "description": "Bottle composition for each delivery"
        }
      }
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Linked Stripe price ID (auto-populated after sync)"
    },
    "stripe_product_id": {
      "type": "string",
      "description": "Linked Stripe product ID (auto-populated after sync)"
    }
  },
  "required": [
    "name",
    "frequency",
    "base_price",
    "bottle_count",
    "discount_percent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}