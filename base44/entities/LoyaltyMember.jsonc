{
  "name": "LoyaltyMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Customer email address"
    },
    "description": {
      "type": "string",
      "description": "Optional admin note about this loyalty member (up to 1000 characters)",
      "maxLength": 1000
    },
    "total_points": {
      "type": "number",
      "default": 0,
      "description": "Current available loyalty points"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Total points ever earned"
    },
    "redeemed_points": {
      "type": "number",
      "default": 0,
      "description": "Total points ever redeemed"
    },
    "points_account_id": { "type": "string", "description": "Authoritative UserPoints record for this projection." },
    "points_ledger_revision": { "type": "integer", "minimum": 0, "default": 0 },
    "reserved_points": { "type": "integer", "minimum": 0, "default": 0 },
    "points_history": {
      "type": "array",
      "default": [],
      "description": "History of point transactions",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "earned",
              "redeemed",
              "bonus",
              "adjustment"
            ]
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "event_key": { "type": "string" },
          "idempotency_key": { "type": "string" },
          "transaction_id": { "type": "string" },
          "transaction_type": { "type": "string" },
          "balanceBefore": { "type": "integer" },
          "balanceAfter": { "type": "integer" },
          "lifetimeBefore": { "type": "integer" },
          "lifetimeAfter": { "type": "integer" },
          "redeemedBefore": { "type": "integer" },
          "redeemedAfter": { "type": "integer" }
        }
      }
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
