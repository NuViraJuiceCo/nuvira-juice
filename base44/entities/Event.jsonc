{
  "name": "Event",
  "type": "object",
  "properties": {
    "hub_event_id": {
      "type": "string",
      "description": "Unique event ID from the hub app (used for upsert matching)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "capacity": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website_link": {
      "type": "string",
      "description": "URL to the event's website"
    },
    "tickets_link": {
      "type": "string",
      "description": "Direct URL to purchase tickets"
    },
    "shopify_pos_inventory_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allows verified event-only production to initialize stock at this event's dedicated Shopify POS location"
    },
    "shopify_pos_location_id": {
      "type": "string",
      "description": "Dedicated Shopify POS location GID for this event"
    },
    "shopify_pos_location_name": {
      "type": "string",
      "description": "Verified display name of the dedicated Shopify POS location"
    },
    "shopify_pos_inventory_mode": {
      "type": "string",
      "enum": [
        "verified_event_production"
      ],
      "description": "Inventory source-of-truth mode for this event"
    }
  },
  "required": [
    "hub_event_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
