{
  "name": "NuViraCredit",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "Customer email address"
    },
    "description": {
      "type": "string",
      "description": "Optional admin note about this credit account (up to 1000 characters)",
      "maxLength": 1000
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "Total unspent credits in dollars; subtract reserved_balance for new checkout availability"
    },
    "reserved_balance": { "type": "number", "minimum": 0, "default": 0 },
    "checkout_reservations": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "properties": {
          "reservation_id": { "type": "string" },
          "context_hash": { "type": "string" },
          "payment_intent_id": { "type": "string" },
          "amount_cents": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["held", "consumed", "released"] },
          "created_at": { "type": "string" },
          "settled_at": { "type": "string" }
        },
        "required": ["reservation_id", "context_hash", "payment_intent_id", "amount_cents", "status"]
      }
    },
    "lifetime_issued": {
      "type": "number",
      "default": 0,
      "description": "Total credits ever issued to this customer"
    },
    "lifetime_used": {
      "type": "number",
      "default": 0,
      "description": "Total credits ever redeemed"
    },
    "credit_ledger_revision": { "type": "integer", "minimum": 0, "default": 0 },
    "history": {
      "type": "array",
      "default": [],
      "description": "History of credit transactions",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "type": {
            "type": "string",
            "enum": [
              "issued",
              "used",
              "adjustment"
            ]
          },
          "description": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "payment_intent_id": { "type": "string" },
          "idempotency_key": { "type": "string" },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
