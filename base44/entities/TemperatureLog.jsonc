{
  "name": "TemperatureLog",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date",
      "description": "Date of log entry"
    },
    "log_time": {
      "type": "string",
      "description": "Time of log entry (HH:MM format)"
    },
    "staff_member": {
      "type": "string",
      "description": "Name of staff member who logged"
    },
    "batch_id": {
      "type": "string",
      "description": "Production batch display ID tied to this temperature check, if applicable"
    },
    "source_production_batch_id": {
      "type": "string",
      "description": "Source ProductionBatch entity ID tied to this temperature check, if applicable"
    },
    "related_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related production batch IDs covered by this temperature check"
    },
    "related_source_production_batch_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related source ProductionBatch entity IDs covered by this temperature check"
    },
    "location": {
      "type": "string",
      "enum": [
        "Cold Room 1",
        "Cold Room 2",
        "Freezer",
        "Walk-in Cooler"
      ],
      "description": "Equipment location"
    },
    "temperature": {
      "type": "number",
      "description": "Temperature value"
    },
    "unit": {
      "type": "string",
      "enum": [
        "F",
        "C"
      ],
      "default": "F",
      "description": "Temperature unit"
    },
    "production_date": {
      "type": "string",
      "format": "date",
      "description": "Production date associated with this check, if applicable"
    },
    "min_range": {
      "type": "number",
      "description": "Minimum acceptable temperature"
    },
    "max_range": {
      "type": "number",
      "description": "Maximum acceptable temperature"
    },
    "within_range": {
      "type": "boolean",
      "description": "Is temperature within acceptable range?"
    },
    "corrective_action_id": {
      "type": "string",
      "description": "Link to corrective action if out of range"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Morning",
        "Afternoon",
        "Night"
      ],
      "description": "Shift when logged"
    },
    "is_test_record": {
      "type": "boolean",
      "default": false,
      "description": "Derived from the linked ProductionBatch; excluded from normal compliance totals when true"
    },
    "test_batch_id": {
      "type": "string",
      "description": "Display ID of the linked internal test ProductionBatch"
    }
  },
  "required": [
    "log_date",
    "log_time",
    "staff_member",
    "location",
    "temperature",
    "within_range"
  ],
  "rls": {
    "create": {
      "data.staff_member": "{{user.full_name}}",
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "production_manager"
          }
        },
        {
          "user_condition": {
            "role": "operations_staff"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.staff_member": "{{user.full_name}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "production_manager"
              }
            },
            {
              "user_condition": {
                "role": "operations_staff"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.staff_member": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
