{
  "name": "DriverActionLog",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to Order entity"
    },
    "order_number": {
      "type": "string",
      "description": "Order number for audit trail"
    },
    "customer_email": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "stage_marked",
        "delivered",
        "unable_to_deliver",
        "bag_verified"
      ],
      "description": "Type of driver action"
    },
    "old_status": {
      "type": "string",
      "description": "Previous order status"
    },
    "new_status": {
      "type": "string",
      "description": "Updated order status"
    },
    "delivery_photo_url": {
      "type": "string",
      "description": "Proof of delivery photo if applicable"
    },
    "delivery_drop_location": {
      "type": "string",
      "description": "Where item was left"
    },
    "unable_to_deliver_reason": {
      "type": "string",
      "description": "Reason if unable to deliver"
    },
    "driver_notes": {
      "type": "string",
      "description": "Driver's notes on the action"
    },
    "performed_by": {
      "type": "string",
      "description": "Driver email"
    },
    "performed_at": {
      "type": "string",
      "description": "ISO timestamp of action"
    },
    "hub_synced": {
      "type": "boolean",
      "default": false,
      "description": "Whether this action was pushed to Hub"
    },
    "hub_sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "failed"
      ],
      "default": "pending",
      "description": "Hub sync result"
    },
    "hub_sync_error": {
      "type": "string",
      "description": "Error message if Hub sync failed"
    }
  },
  "required": [
    "order_id",
    "action_type",
    "performed_by"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "driver"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "driver"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}