{
  "name": "SafeSyncParityLog",
  "type": "object",
  "description": "Admin-only dry-run parity log for native safeSync dark-launch validation. Runtime writers must not store raw order payloads, provider payloads, secrets, auth headers, full addresses, phone numbers, stack traces, proof/drop evidence, or unredacted payment/provider ids.",
  "properties": {
    "sample_id": {
      "type": "string",
      "description": "Unique identifier for this dark-launch parity sample."
    },
    "request_id": {
      "type": "string",
      "description": "Safe request id if one was provided by the caller or bridge."
    },
    "correlation_id": {
      "type": "string",
      "description": "Safe correlation id for tying the comparison to a bridge invocation."
    },
    "order_id": {
      "type": "string",
      "description": "Safe Customer App order or operational order id."
    },
    "order_number": {
      "type": "string",
      "description": "Safe order number used for exact allowlisted parity sampling."
    },
    "source": {
      "type": "string",
      "description": "Dark-launch source label, such as customer_app."
    },
    "event_type": {
      "type": "string",
      "description": "Dark-launch event type, such as order.created."
    },
    "bridge_action": {
      "type": "string",
      "description": "Existing Hub bridge action summary, such as created, updated, dedupe_exact_match, queued_for_review, rejected, skipped, or error."
    },
    "hub_result_status": {
      "type": "string",
      "description": "Safe status summary returned by the existing Hub bridge."
    },
    "native_parity_status": {
      "type": "string",
      "enum": [
        "match",
        "acceptable_difference",
        "mismatch",
        "unsupported",
        "blocked",
        "needs_manual_review"
      ],
      "description": "Native dry-run parity result. This is diagnostic only and does not imply a native writer ran."
    },
    "mismatch_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Safe mismatch category labels only."
    },
    "mismatch_count": {
      "type": "number",
      "description": "Count of detected parity differences."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Safe warning labels only."
    },
    "native_would_create_order": {
      "type": "boolean",
      "description": "Whether native dry-run planning would create an order. Diagnostic only."
    },
    "native_would_update_order": {
      "type": "boolean",
      "description": "Whether native dry-run planning would update an order. Diagnostic only."
    },
    "native_would_quarantine": {
      "type": "boolean",
      "description": "Whether native dry-run planning would queue or quarantine the order. Diagnostic only."
    },
    "native_would_reject": {
      "type": "boolean",
      "description": "Whether native dry-run planning would reject the incoming update. Diagnostic only."
    },
    "accepted_fields_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accepted field names only. Do not store raw field values."
    },
    "rejected_fields_summary": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rejected field names only. Do not store raw field values."
    },
    "redaction_applied": {
      "type": "boolean",
      "description": "True when the logged summary has been redacted to exclude raw payloads and sensitive values."
    },
    "logging_mode": {
      "type": "string",
      "enum": [
        "persistent"
      ],
      "description": "Persistent parity logging mode. Debug-return and console-only observations should not create this entity."
    },
    "native_writer_enabled": {
      "type": "boolean",
      "description": "Must remain false for dark-launch parity logs until native safeSync writes are separately approved."
    },
    "created_at": {
      "type": "string",
      "description": "ISO timestamp when the parity log was created."
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
