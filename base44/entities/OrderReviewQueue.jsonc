{
  "name": "OrderReviewQueue",
  "type": "object",
  "properties": {
    "incident_type": {
      "type": "string",
      "description": "Quarantine or review reason, such as missing_customer_info, low_quality_new_order, overwrite_rejection, or partial_refund_received."
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "existing_order_id": {
      "type": "string"
    },
    "existing_order_number": {
      "type": "string"
    },
    "existing_order_type": {
      "type": "string"
    },
    "incoming_payload": {
      "type": "object",
      "description": "Admin-only safe payload snapshot for review. Runtime writers must not store secrets, auth headers, provider raw payload dumps, or stack traces."
    },
    "incoming_source": {
      "type": "string"
    },
    "issue_description": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "admin_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewing",
        "resolved",
        "rejected",
        "archived"
      ],
      "default": "pending"
    },
    "resolved_action": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "occurrence_count": {
      "type": "number"
    },
    "first_seen_at": {
      "type": "string"
    },
    "last_seen_at": {
      "type": "string"
    },
    "queue_visibility_status": {
      "type": "string"
    },
    "archived_at": {
      "type": "string"
    },
    "archived_by": {
      "type": "string"
    },
    "archived_reason": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
