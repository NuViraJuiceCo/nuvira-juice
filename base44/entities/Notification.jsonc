{
  "name": "Notification",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "order_update",
        "promotion",
        "new_drop",
        "general"
      ],
      "default": "general"
    },
    "order_id": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "title",
    "message"
  ]
}