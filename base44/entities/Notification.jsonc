{
  "name": "Notification",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional additional context or admin note for this notification (up to 1000 characters)",
      "maxLength": 1000
    },
    "type": {
      "type": "string",
      "enum": [
        "order_update",
        "promotion",
        "new_drop",
        "general"
      ],
      "default": "general"
    },
    "order_id": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.customer_email": "{{user.email}}"
    },
    "update": {
      "data.customer_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}