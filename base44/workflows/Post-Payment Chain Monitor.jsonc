{
  "name": "Post-Payment Chain Monitor",
  "description": "Hourly read-only verification that paid orders reached Customer App native operational, fulfillment, and audit records.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 60,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-08T01:13:32.452000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_payment_chain_monitor",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getAdminOperationsDashboardSummary",
            "args": {
              "gateway_action": "monitorPostPaymentChain"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "getAdminOperationsDashboardSummary"
  }
}