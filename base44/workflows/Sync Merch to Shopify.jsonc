{
  "name": "Sync Merch to Shopify",
  "description": "Preserved inactive legacy automation; route through the consolidated admin gateway if deliberately re-enabled.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Merch"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_merch_to_shopify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getAdminOperationsDashboardSummary",
            "args": {
              "gateway_action": "pushMerchToShopify"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "getAdminOperationsDashboardSummary"
  }
}