{
  "name": "Push Product to Shopify on Create/Update",
  "description": "Preserved inactive legacy automation; route through the consolidated admin gateway if deliberately re-enabled.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Product"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_product_to_shopify_on_create_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getAdminOperationsDashboardSummary",
            "args": {
              "gateway_action": "pushProductToShopify"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "getAdminOperationsDashboardSummary"
  }
}