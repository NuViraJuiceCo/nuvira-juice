{
  "name": "Order Status Notification Trigger",
  "description": "Fires sendOrderStatusNotification when an order status changes to a delivery milestone (out_for_delivery, delivered, arriving_soon, etc.)",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"scheduled_for_juicing\" or .trigger.data.status == \"in_production\" or .trigger.data.status == \"out_for_delivery\" or .trigger.data.status == \"arriving_soon\" or .trigger.data.status == \"delivered\" or .trigger.data.status == \"ready_for_pickup\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "order_status_notification_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOrderStatusNotification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendOrderStatusNotification"
  }
}